// use prisma-8
model Post {
  id         Int       @id @default(autoincrement())
  title      String    @unique
  content    String?
  author     String

  category   String
  categoryId Int?
  categoryRef Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?

  posts       Post[]
}