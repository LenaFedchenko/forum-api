  {
    "id": "table.Post",
    "label": "Create table \"Post\"",
    "summary": "Creates table \"Post\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "Post"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"Post\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"Post\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"Post\"",
        "sql": "CREATE TABLE \"public\".\"Post\" (\n  \"author\" text NOT NULL,\n  \"category\" text NOT NULL,\n  \"content\" text,\n  \"id\" SERIAL NOT NULL,\n  \"title\" text NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"Post\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"Post\""
        ]
      }
    ]
  },
  {
    "id": "unique.Post.Post_title_key",
    "label": "Add unique constraint on \"Post\" (title)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Post_title_key",
        "table": "Post"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Post_title_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Post_title_key",
          "public",
          "\"public\".\"Post\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Post_title_key\"",
        "sql": "ALTER TABLE \"public\".\"Post\" ADD CONSTRAINT \"Post_title_key\" UNIQUE (\"title\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"Post_title_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Post_title_key",
          "public",
          "\"public\".\"Post\""
        ]
      }
    ]
  }
